<?xml version="1.0"?>
<ruleset name="peq-compat">
    <description>
        Cross-version PHP compatibility gate. The project declares "php": "^8.1"
        and documents support for 8.1 through 8.5, so any syntax or function newer
        than the 8.1 floor must be reported. Only PHPCompatibility runs here —
        code style is owned by PHP-CS-Fixer.
    </description>

    <file>bin</file>
    <file>config</file>
    <file>src</file>
    <file>tests</file>

    <!-- Analyzer fixtures are deliberate syntax samples fed to the collector tests,
         so they are not production code and must not be gated. -->
    <exclude-pattern>tests/Fixture/Source/*</exclude-pattern>
    <exclude-pattern>tests/Fixture/Sample/*</exclude-pattern>

    <!-- Floor of the supported range. Trailing "-" means "8.1 and up",
         i.e. flag everything introduced after 8.1. -->
    <config name="testVersion" value="8.1-"/>

    <rule ref="PHPCompatibility"/>
</ruleset>
