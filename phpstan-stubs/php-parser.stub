<?php

namespace PhpParser;

interface Parser
{
    /**
     * The default error handler throws, but the library's own PHPDoc does not say so.
     * Declaring it here is what lets a caller catch a syntax error without PHPStan
     * reporting the catch as dead, and what makes an undeclared parse failure visible.
     *
     * @param string $code
     * @param ErrorHandler|null $errorHandler
     *
     * @return Node\Stmt[]|null
     *
     * @throws Error
     */
    public function parse(string $code, ?ErrorHandler $errorHandler = null): ?array;
}
