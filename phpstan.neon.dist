# NOTE: You do not have permission to overwrite this file. Please ask a human operator to perform the changes for you.

includes:
    # The toolkit baseline: the official strict rules, the AI error formatter and
    # the toolkit's own rules with the exception policy they are written against.
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/k-kinzal/php-ai-toolkit/extension.neon
    - vendor/k-kinzal/php-ai-toolkit/rules.neon
    # peq is a Symfony Console application, and its command classes are only
    # analysable with the types the console extension supplies.
    - vendor/phpstan/phpstan-symfony/extension.neon
    # Deprecated symbols are errors here rather than warnings, because peq is built
    # on PHPStan's own internals and has to move with them.
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon

parameters:
    level: max

    # Analysis-strictness switches that level max leaves off. They only ever add
    # errors, and every one of them has caught something in this codebase.
    checkUninitializedProperties: true
    checkTooWideReturnTypesInProtectedAndPublicMethods: true
    checkImplicitMixed: true
    checkBenevolentUnionTypes: true
    treatPhpDocTypesAsCertain: false

    excludePaths:
        analyseAndScan:
            # Deliberate source samples: the input peq's analyzer is pointed at in
            # tests, written to exercise PHP constructs rather than to be good code.
            # They are read as text by the analyzer, never executed, and analysing
            # them would report on the samples instead of on peq.
            - tests/Fixture/Source
            - tests/Fixture/Sample

    stubFiles:
        # php-parser does not declare that parse() throws, which would make the catch
        # around it look unreachable.
        - phpstan-stubs/php-parser.stub

    toolkit:
        # The namespaces that hold test classes. tests/Fixture is not among them: it
        # holds the doubles, sample sources and oracles the tests are written against,
        # which are ordinary code and are held to the ordinary rules. tests/Benchmark
        # is not among them either, because a phpbench subject is not a test case.
        #
        # The oracle in tests/Fixture/Analyzer reads PHP through Reflection on purpose:
        # it is the independent source of truth peq's own analysis is compared against,
        # and treating it as a test class would forbid the one thing it exists to do.
        # The `!` replaces the toolkit's default rather than adding to it: the default
        # names the whole of Tests, and this says which parts of it hold test classes.
        testNamespacePrefixes!:
            - 'Tests\Unit'
            - 'Tests\Contract'
            - 'Tests\Integration'
        # Every one of those namespaces holds PHPUnit test classes, so the rules about
        # how a test is written apply to all of them rather than to the unit suite
        # alone, which is all the toolkit can assume by default.
        restrictedTestNamespacePrefixes:
            - 'Tests\Unit'
            - 'Tests\Contract'
            - 'Tests\Integration'
        broadCatchAllowedPaths:
            # The console entry point is the process boundary: it has to turn any
            # failure into an exit status, because there is nothing above it left to
            # catch one.
            - 'bin/console'

    ignoreErrors:
        # peq runs PHPStan in process to read the types it resolves: which class a
        # call lands on, not merely which name was written. The container, the
        # analyser and the phar autoloader that make that possible carry no backward
        # compatibility promise, and PHPStan offers no supported interface that
        # answers the same question — its supported surface reports errors, and peq
        # needs the analysis itself. This is therefore the recorded cost of the
        # architecture rather than a silenced defect, and it is confined to the three
        # files that speak to PHPStan directly; every other part of peq works on
        # peq's own graph. Removing it means driving PHPStan as a subprocess through
        # a custom error formatter, which is a design change, not a configuration one.
        -
            identifier: phpstanApi.classConstant
            paths:
                - src/Analyzer/PhpStanAnalyzer/PhpStanAnalyzer.php
                - src/Analyzer/PhpStanAnalyzer/PhpStanAutoloader.php
        -
            identifier: phpstanApi.method
            paths:
                - src/Analyzer/PhpStanAnalyzer/PhpStanAnalyzer.php
                - src/Analyzer/PhpStanAnalyzer/Processor/Usage/FunctionCallProcessor.php
