# NOTE: You do not have permission to overwrite this file. Please ask a human operator to perform the changes for you.

includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/k-kinzal/php-ai-toolkit/extension.neon
    - vendor/k-kinzal/php-ai-toolkit/rules.neon

parameters:
    level: max
    paths:
        - bin
        - src
        - tests
    excludePaths:
        - tests/Fixture
    toolkit:
        restrictedTestNamespacePrefixes:
            - 'Tests\Contract'
    ignoreErrors:
        -
            identifier: phpstanApi.classConstant
            path: src/Analyzer/PhpStanAnalyzer/PhpStanAnalyzer.php
        -
            identifier: phpstanApi.method
            path: src/Analyzer/PhpStanAnalyzer/PhpStanAnalyzer.php
        -
            identifier: phpstanApi.classConstant
            path: src/Analyzer/PhpStanAnalyzer/PhpStanAutoloader.php
        -
            identifier: phpstanApi.method
            path: src/Analyzer/PhpStanAnalyzer/Processor/Usage/FunctionCallProcessor.php
