{
    "name": "k-kinzal/peq",
    "description": "A CLI tool that analyzes PHP code dependencies and visualizes the blast radius of changes.",
    "license": "MIT",
    "type": "project",
    "homepage": "https://github.com/k-kinzal/peq",
    "support": {
        "source": "https://github.com/k-kinzal/peq",
        "issues": "https://github.com/k-kinzal/peq/issues"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/k-kinzal/php-ai-toolkit.git",
            "no-api": true
        }
    ],
    "require": {
        "php": "^8.1",
        "fakerphp/faker": "^1.24",
        "phpstan/phpstan": "^2.0",
        "symfony/config": "^6.4 || ^7.0",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "symfony/finder": "^6.4 || ^7.0",
        "symfony/validator": "^6.4 || ^7.0",
        "symfony/yaml": "^6.4 || ^7.0"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.8",
        "brianium/paratest": "^6.11 || ^7",
        "deptrac/deptrac": "^3.0 || ^4.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "giorgiosironi/eris": "^1.0",
        "infection/infection": "^0.27 || ^0.28 || ^0.29 || ^0.30 || ^0.31 || ^0.32 || ^0.33 || ^0.34 || ^0.35",
        "k-kinzal/php-ai-toolkit": "dev-main",
        "mikey179/vfsstream": "^1.6",
        "phpbench/phpbench": "^1.2",
        "phpcompatibility/php-compatibility": "^10.0@alpha",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^10.0 || ^11.0 || ^12.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "classmap": [
            "tests/Fixture/Sample/",
            "tests/Fixture/Source/"
        ]
    },
    "bin": [
        "bin/console"
    ],
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "infection/extension-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "target-directory": "vendor-bin",
            "forward-command": true
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@composer bin box require --dev humbug/box"
        ],
        "post-update-cmd": [
            "@composer bin box require --dev humbug/box"
        ],
        "bench": "phpbench run --report=aggregate",
        "compat": "phpcs",
        "compile": "box compile",
        "deptrac": "deptrac analyse --config-file=deptrac.yaml",
        "doc-gen": "doc-gen --exclude='tests/Fixture/*' --coverage=build/coverage-xml",
        "doc-gen:diff": "@doc-gen --diff=main --serve",
        "doc-gen:fresh": "@doc-gen --no-cache",
        "doc-gen:serve": "@doc-gen --serve",
        "doctest": "phpunit --testsuite doctest",
        "format": "php-cs-fixer fix --allow-risky=yes",
        "format:check": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "lint": [
            "@format:check",
            "@phpstan",
            "@compat",
            "@loc-guard",
            "@tree-guard",
            "@scope-guard",
            "@deptrac"
        ],
        "loc-guard": "loc-guard --config=loc.yaml",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "scope-guard": "scope-guard --config=scope.yaml",
        "test": "paratest --processes=auto",
        "test:contract": "phpunit --testsuite contract",
        "test:integration": "phpunit --testsuite integration",
        "test:serial": "@php -d memory_limit=1G vendor/bin/phpunit --configuration phpunit.xml.dist",
        "test:unit": "phpunit --testsuite unit",
        "tree-guard": "tree-guard --config=tree.yaml"
    }
}
