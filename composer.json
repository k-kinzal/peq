{
    "name": "k-kinzal/peq",
    "description": "A CLI tool that analyzes PHP code dependencies and visualizes the blast radius of changes.",
    "license": "MIT",
    "type": "project",
    "homepage": "https://github.com/k-kinzal/peq",
    "support": {
        "source": "https://github.com/k-kinzal/peq",
        "issues": "https://github.com/k-kinzal/peq/issues"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/k-kinzal/php-ai-toolkit.git",
            "no-api": true
        }
    ],
    "require": {
        "php": "^8.3",
        "nikic/php-parser": "^5.0",
        "symfony/config": "^6.4 || ^7.0",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "symfony/finder": "^6.4 || ^7.0",
        "symfony/validator": "^6.4 || ^7.0",
        "symfony/yaml": "^6.4 || ^7.0"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.8",
        "behat/behat": "^3.29",
        "deptrac/deptrac": "^4.4",
        "friendsofphp/php-cs-fixer": "^3.0",
        "giorgiosironi/eris": "^1.0",
        "k-kinzal/php-ai-toolkit": "dev-main",
        "mikey179/vfsstream": "^1.6",
        "phpbench/phpbench": "^1.2",
        "phpcompatibility/php-compatibility": "^10.0@alpha",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.0.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Spec\\": "spec/"
        },
        "classmap": [
            "tests/Fixture/Sample/",
            "tests/Fixture/Source/"
        ]
    },
    "bin": [
        "bin/console"
    ],
    "config": {
        "process-timeout": 0,
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "target-directory": "vendor-bin",
            "forward-command": true
        }
    },
    "scripts": {
        "bench": "phpbench run --report=aggregate",
        "bench:quick": "phpbench run --report=aggregate --warmup=1 --iterations=3 --retry-threshold=10",
        "compat": "phpcs",
        "compile": "box compile",
        "deptrac": "deptrac analyse --config-file=deptrac.yaml",
        "docgen": "docgen --exclude='tests/Fixture/*' --coverage=build/coverage-xml",
        "docgen:diff": "@docgen --diff=main --serve",
        "docgen:fresh": "@docgen --no-cache",
        "docgen:serve": "@docgen --serve",
        "doctest": "phpunit --testsuite doctest",
        "format": "php-cs-fixer fix --allow-risky=yes",
        "format:check": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "lint": [
            "@format:check",
            "@phpstan",
            "@compat",
            "@loc-guard",
            "@tree-guard",
            "@deptrac"
        ],
        "loc-guard": "loc-guard --config=loc.yaml",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "spec": "behat --strict",
        "post-install-cmd": [
            "@composer bin box require --dev humbug/box"
        ],
        "post-update-cmd": [
            "@composer bin box require --dev humbug/box"
        ],
        "test": "phpunit --exclude-group=pbt",
        "test:equivalence": "phpunit tests/Equivalence",
        "test:contract": "phpunit --testsuite contract --exclude-group=pbt",
        "test:integration": "phpunit --testsuite integration --exclude-group=pbt",
        "test:pbt": "phpunit --group=pbt",
        "test:unit": "phpunit --testsuite unit --exclude-group=pbt",
        "tree-guard": "tree-guard --config=tree.yaml"
    },
    "scripts-descriptions": {
        "spec": "Run the Behat specification of ISO/IEC 39075 (GQL) against the query engine."
    }
}
